# Copia este archivo como ".env" y llena tus datos. NUNCA subas el .env a GitHub.

PORT=3000

# Cadena de conexión de MongoDB (local o Atlas)
# Local:  mongodb://127.0.0.1:27017/zucafe
# Atlas:  mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/zucafe
MONGODB_URI=mongodb://127.0.0.1:27017/zucafe

# Credenciales del panel admin (cámbialas)
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave
# Texto largo y aleatorio para firmar las sesiones
JWT_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# Dominios permitidos (tu GitHub Pages), separados por coma. Usa * mientras pruebas.
# Ejemplo: https://tuusuario.github.io
CORS_ORIGIN=*

# Datos que usa el chatbot (ajústalos a tu negocio real)
NEGOCIO_HORARIO=Lunes a sábado de 8:00 a. m. a 6:00 p. m.
NEGOCIO_UBICACION=Cundinamarca, Colombia. Hacemos entregas y envíos; escríbenos por WhatsApp para coordinar.
NEGOCIO_WHATSAPP=573000000000

# OPCIONAL: si pones tu clave, el chatbot responde con IA (Claude).
# Si la dejas vacía, usa respuestas inteligentes por reglas y funciona igual.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
